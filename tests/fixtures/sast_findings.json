{
 "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
 "version": "2.1.0",
 "runs": [
  {
   "tool": {
    "driver": {
     "name": "SnykCode",
     "rules": [
      {
       "id": "javascript/Sqli",
       "name": "Sqli",
       "shortDescription": {
        "text": "SQL Injection"
       }
      },
      {
       "id": "javascript/XSS",
       "name": "XSS",
       "shortDescription": {
        "text": "Cross-site Scripting (XSS)"
       }
      },
      {
       "id": "javascript/Hardcoded",
       "name": "Hardcoded",
       "shortDescription": {
        "text": "Hardcoded Secret"
       }
      }
     ]
    }
   },
   "results": [
    {
     "ruleId": "javascript/Sqli",
     "level": "error",
     "message": {
      "text": "Unsanitized input flows into query"
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "src/db.js",
         "uriBaseId": "%SRCROOT%"
        },
        "region": {
         "startLine": 42
        }
       }
      }
     ]
    },
    {
     "ruleId": "javascript/XSS",
     "level": "warning",
     "message": {
      "text": "Unsanitized input in HTML"
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "src/view.js",
         "uriBaseId": "%SRCROOT%"
        },
        "region": {
         "startLine": 7
        }
       }
      }
     ]
    },
    {
     "ruleId": "javascript/Hardcoded",
     "level": "note",
     "message": {
      "text": "Hardcoded value"
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "src/conf.js",
         "uriBaseId": "%SRCROOT%"
        },
        "region": {
         "startLine": 3
        }
       }
      }
     ]
    }
   ]
  }
 ]
}